# Environment Configuration Template
# Copy this file to .env and fill in real values. .env is git-ignored.

# Backend environment: controls logging verbosity, error details, and behavior
# Values: development (verbose output) or production (minimal output)
ENVIRONMENT=development

# LangSmith Tracing: enable/disable agent execution tracing and debugging
# Set to true to see detailed traces in the LangSmith dashboard
LANGSMITH_TRACING=true

# LangSmith API Key: required to authenticate with LangSmith service
# Get your key from https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here

# LangSmith Project Name: groups traces under this project in the dashboard
LANGSMITH_PROJECT=datalens-ai

# OpenRouter API Key: used to call LLMs via OpenRouter's OpenAI-compatible API
# Get your key from https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here
